{
  "name": "@twentyfirstmedia/ui",
  "version": "0.7.0",
  "description": "CLI and MCP server for the Twentyfirst UI kits: set up an app, copy components, give coding agents the docs.",
  "license": "MIT",
  "author": "Twentyfirst Media (https://twentyfirst.media)",
  "homepage": "https://ui.twentyfirst.media/halo/cli/",
  "bugs": {
    "url": "https://github.com/twentyfirstmedia/ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "cli",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "design-system"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twentyfirstmedia/ui.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "twentyfirst-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/copy-shared.ts && tsc -p tsconfig.build.json && node ../../scripts/knowledge.ts dist/knowledge.json",
    "typecheck": "node ../../scripts/copy-shared.ts && tsc --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
