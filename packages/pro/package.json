{
  "name": "@twentyfirstmedia/pro",
  "version": "0.1.1",
  "description": "Pro: sharp, dense, hairline grid, dark-first. Same components and props as Halo.",
  "license": "MIT",
  "author": "Twentyfirst Media (https://twentyfirst.media)",
  "homepage": "https://ui.twentyfirst.media/pro/",
  "bugs": {
    "url": "https://github.com/twentyfirstmedia/ui/issues"
  },
  "keywords": [
    "react",
    "ui-kit",
    "components",
    "design-system",
    "tailwind",
    "dark-mode",
    "accessible",
    "pro"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twentyfirstmedia/ui.git",
    "directory": "packages/pro"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./scoped.css": "./dist/scoped.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts/*": "./dist/fonts/*",
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-css.ts pro",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@twentyfirstmedia/ui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
