{
  "name": "@twentyfirstmedia/ui-core",
  "version": "0.2.1",
  "description": "Components, hooks, icons and formatters shared by the Halo and Pro kits.",
  "license": "MIT",
  "author": "Twentyfirst Media (https://twentyfirst.media)",
  "homepage": "https://ui.twentyfirst.media",
  "bugs": {
    "url": "https://github.com/twentyfirstmedia/ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "halo",
    "pro",
    "accessible"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twentyfirstmedia/ui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes.css": "./dist/themes.css",
    "./fonts/*": "./dist/fonts/*",
    "./themes/*": "./dist/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-css.ts themes",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.3",
    "react-dom": ">=18.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
